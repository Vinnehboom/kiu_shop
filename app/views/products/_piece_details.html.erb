<% measurements = product.measurements %>
<% details = product.details %>
<% safety_claims = product.safety_claims %>

<% unless [measurements, details, safety_claims].all?(&:empty?) %>
  <div class="product-page__details">
    <h2 class="product-properties__title"><%= t('.title') %></h2>

    <table class="product-properties__table">
      <tbody>
        <% if measurements.weight? %>
          <%= render 'products/piece_detail_row', label: Spree::Product.human_attribute_name(:weight), value: measurements.formatted_weight %>
        <% end %>
        <% if measurements.dimensions? %>
          <%= render 'products/piece_detail_row', label: t('.dimensions'), value: measurements.formatted_dimensions %>
        <% end %>
        <% details.filled.each do |attribute, value| %>
          <%= render 'products/piece_detail_row', label: Spree::Product.human_attribute_name(attribute), value: value %>
        <% end %>
        <% safety_claims.claimed.each do |claim| %>
          <%= render 'products/piece_detail_row', label: Spree::Product.human_attribute_name(claim), value: t('spree.say_yes') %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
