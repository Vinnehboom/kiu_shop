<% measurements = product.measurements %>
<% details = product.details %>
<% safety_claims = product.safety_claims %>

<% unless [measurements, details, safety_claims].all?(&:empty?) %>
  <div class="product-page__details">
    <h2 class="product-properties__title"><%= t('.title') %></h2>

    <table class="product-properties__table">
      <tbody>
        <%= render PieceDetailRowComponent.new(label: Spree::Product.human_attribute_name(:weight), value: measurements.formatted_weight) %>
        <%= render PieceDetailRowComponent.new(label: t('.dimensions'), value: measurements.formatted_dimensions) %>
        <% details.to_h.each do |fact, value| %>
          <%= render PieceDetailRowComponent.new(label: Spree::Product.human_attribute_name(fact), value: value) %>
        <% end %>
        <% safety_claims.claimed.each do |claim| %>
          <%= render PieceDetailRowComponent.new(label: Spree::Product.human_attribute_name(claim), value: t('spree.say_yes')) %>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
